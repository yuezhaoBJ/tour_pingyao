.page {
  padding: 24rpx 24rpx 120rpx;
}

.agent {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.agent-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 3rpx solid #3dd5ff;
}

.agent-meta {
  flex: 1;
  min-width: 0;
}

.name {
  font-weight: 800;
  font-size: 30rpx;
}

.role {
  font-size: 22rpx;
  color: #7ae7ff;
  margin-top: 4rpx;
}

.change {
  font-size: 22rpx;
  color: #7ae7ff;
  border: 1rpx solid rgba(61, 213, 255, 0.4);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.spots {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.spot {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(61, 213, 255, 0.28);
  background: rgba(8, 14, 24, 0.65);
  font-size: 24rpx;
  color: rgba(232, 238, 245, 0.8);
}

.spot.on {
  border-color: rgba(240, 193, 75, 0.6);
  background: rgba(240, 193, 75, 0.12);
  color: #f0c14b;
  font-weight: 700;
}

.spot .e {
  font-size: 28rpx;
}

.head {
  margin-bottom: 24rpx;
}

.h1 {
  font-size: 34rpx;
  font-weight: 800;
}

.desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(232, 238, 245, 0.65);
  line-height: 1.55;
}

.progress {
  margin-top: 20rpx;
}

.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(61, 213, 255, 0.15);
  overflow: hidden;
}

.fill {
  height: 100%;
  background: linear-gradient(90deg, #2ecfff, #f0c14b);
}

.prog-text {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7ae7ff;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.task {
  position: relative;
  padding: 18rpx;
  overflow: hidden;
}

.task.done {
  border-color: rgba(61, 214, 140, 0.45);
}

.top {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.icon {
  font-size: 36rpx;
}

.num {
  font-size: 18rpx;
  color: #7ae7ff;
  letter-spacing: 1rpx;
}

.t {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
}

.cover {
  width: 100%;
  height: 180rpx;
  border-radius: 14rpx;
  background: #0a121c;
  border: 1rpx solid rgba(61, 213, 255, 0.28);
}

.short {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(232, 238, 245, 0.62);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.check {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #3dd68c;
  color: #041018;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.badge {
  position: absolute;
  left: 28rpx;
  top: 210rpx;
  font-size: 18rpx;
  background: rgba(232, 120, 48, 0.92);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.footer {
  margin-top: 36rpx;
  text-align: center;
}

.tip {
  font-size: 24rpx;
  color: rgba(232, 238, 245, 0.5);
}
