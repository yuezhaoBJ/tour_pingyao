.page {
  padding: 24rpx 24rpx 80rpx;
}

.hero {
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(61, 213, 255, 0.3);
}

.block {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 800;
}

.place {
  margin-top: 8rpx;
  color: #7ae7ff;
  font-size: 24rpx;
}

.h {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.p {
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(232, 238, 245, 0.88);
}

.p.muted {
  opacity: 0.75;
  margin-top: 8rpx;
}

.em {
  color: #f0c14b;
}

.knowledge {
  border-color: rgba(240, 193, 75, 0.35);
}

.step {
  font-size: 22rpx;
  color: #7ae7ff;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.choices {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.choice {
  text-align: left;
  background: rgba(61, 213, 255, 0.08);
  border: 1rpx solid rgba(61, 213, 255, 0.35);
  color: #e8eef5;
  border-radius: 16rpx;
  font-size: 26rpx;
  padding: 22rpx 24rpx;
  line-height: 1.45;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.28);
  border: 1rpx solid rgba(61, 213, 255, 0.35);
  border-radius: 16rpx;
  padding: 20rpx;
  color: #fff;
  margin: 16rpx 0;
}

.fb {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.fb.ok {
  background: rgba(61, 214, 140, 0.15);
  border: 1rpx solid #3dd68c;
  color: #b8f5d4;
}

.fb.bad {
  background: rgba(198, 40, 40, 0.15);
  border: 1rpx solid #c62828;
  color: #ffc9c9;
}

.photo-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.preview {
  position: relative;
  margin-top: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(61, 213, 255, 0.35);
}

.preview image {
  width: 100%;
  display: block;
}

.stamp {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
}

.actions {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
}

.actions .btn-primary,
.actions .btn-ghost {
  flex: 1;
}
