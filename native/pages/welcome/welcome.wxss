.page {
  padding: 40rpx 32rpx 80rpx;
}

.hero {
  padding: 48rpx 36rpx;
  text-align: center;
  margin-bottom: 28rpx;
}

.emoji {
  font-size: 72rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(232, 238, 245, 0.65);
  line-height: 1.5;
}

.form {
  padding: 36rpx;
}

.label {
  font-size: 24rpx;
  font-weight: 700;
  color: #7ae7ff;
  margin-bottom: 12rpx;
}

.input {
  background: rgba(0, 0, 0, 0.28);
  border: 1rpx solid rgba(61, 213, 255, 0.35);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: #fff;
  margin-bottom: 28rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #f0c14b;
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a2838;
  font-size: 48rpx;
}

.hint {
  font-size: 22rpx;
  color: rgba(232, 238, 245, 0.55);
  margin-bottom: 36rpx;
}

.start {
  width: 100%;
}
