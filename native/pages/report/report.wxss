.page {
  padding: 24rpx 24rpx 100rpx;
}

.hero {
  padding: 40rpx 28rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #f0c14b;
}

.name {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.chips {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.sub {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(232, 238, 245, 0.6);
}

.gallery {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  align-items: start;
}

.entry {
  overflow: hidden;
  padding-bottom: 12rpx;
}

.stage {
  position: relative;
  width: 100%;
  height: 280rpx;
  background: #0a121c;
}

.stage image {
  width: 100%;
  height: 100%;
}

.empty {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(232, 238, 245, 0.45);
  font-size: 24rpx;
}

.wm {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  gap: 10rpx;
  align-items: center;
  padding: 8rpx 12rpx 8rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  pointer-events: none;
}

.wm-av {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #f0c14b;
  flex-shrink: 0;
}

.wm-lines {
  min-width: 0;
  flex: 1;
}

.wm-title,
.wm-place,
.wm-time {
  font-size: 18rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.25;
}

.wm-title {
  color: #fff;
  font-weight: 800;
}

.wm-place {
  color: #7ae7ff;
  font-weight: 700;
}

.wm-time {
  color: rgba(255, 255, 255, 0.9);
}

.body {
  padding: 14rpx 16rpx 8rpx;
  font-size: 22rpx;
  color: rgba(232, 238, 245, 0.7);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.save-one {
  margin: 0 16rpx 8rpx;
  font-size: 22rpx;
  padding: 10rpx 0;
}

.foot {
  margin-top: 24rpx;
  padding: 28rpx;
  text-align: center;
  border-color: rgba(240, 193, 75, 0.4);
}

.reward {
  color: #f0c14b;
  font-size: 32rpx;
  font-weight: 800;
}

.msg {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(232, 238, 245, 0.75);
  line-height: 1.5;
}

.actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.actions button {
  flex: 1;
}
